{
  "title": "AI Business Metrics",
  "tags": ["ai", "business", "tickets"],
  "timezone": "browser",
  "panels": [
    {
      "type": "timeseries",
      "title": "Tickets Processed by Category",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_ticket_processed_total[5m])) by (category)",
          "legendFormat": "{{category}}"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Average Confidence Score",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(ai_confidence_score_sum[5m])) / sum(rate(ai_confidence_score_count[5m]))"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 0.7 }, { "color": "green", "value": 0.9 } ]
          }
        }
      }
    },
    {
      "type": "piechart",
      "title": "Priority Distribution",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(ai_ticket_processed_total) by (priority)",
          "legendFormat": "{{priority}}"
        }
      ]
    }
  ],
  "schemaVersion": 38
}
